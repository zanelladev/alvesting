{
  "name": "alvesting",
  "version": "0.0.0",
  "private": true,
  "description": "Alvesting v2: arena pública de LLMs operando ações da B3 com dinheiro fictício",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13 <27"
  },
  "prettier": "@alvesting/config/prettier",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && node --test \"scripts/*.test.mjs\"",
    "coverage": "node scripts/coverage.mjs",
    "test:e2e": "turbo run test:e2e",
    "lighthouse": "node scripts/lighthouse.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm docs:check"
  },
  "devDependencies": {
    "@alvesting/config": "workspace:*",
    "@lhci/cli": "0.15.1",
    "prettier": "3.9.10",
    "turbo": "2.11.10"
  }
}
