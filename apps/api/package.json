{
  "name": "@alvesting/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API, workers e agendadores da Alvesting (NestJS 12, uma imagem em quatro papéis)",
  "scripts": {
    "generate": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local\"",
    "start": "node --enable-source-maps --import ./dist/telemetry/preload.js dist/main.js",
    "start:worker": "node --enable-source-maps --import ./dist/telemetry/preload.js dist/worker.js",
    "start:decide": "node --enable-source-maps --import ./dist/telemetry/preload.js dist/decide.js",
    "start:schedule": "node --enable-source-maps --import ./dist/telemetry/preload.js dist/schedule.js",
    "migrate:deploy": "prisma migrate deploy",
    "db:roles": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/db-roles-cli.js",
    "market:backfill": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/market-cli.js backfill",
    "market:universe": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/market-cli.js universe",
    "market:logos": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/market-cli.js logos",
    "news:fetch": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/news-cli.js fetch",
    "news:import": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/news-cli.js import",
    "briefing:freeze": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/briefing-cli.js freeze",
    "season:create": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/arena-cli.js season-create",
    "season:start": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/arena-cli.js season-start",
    "cycle:show": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/arena-cli.js cycle-show",
    "account:promote": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/account-cli.js promote",
    "account:demote": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/account-cli.js demote",
    "settle:event": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/settlement-cli.js event",
    "arena:ensaio": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example dist/ensaio-cli.js",
    "temporada:preparar": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/temporada-cli.js preparar",
    "arena:retroativo": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/temporada-cli.js retroativo",
    "arena:operar": "nest build && node --enable-source-maps --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env.local dist/temporada-cli.js operar",
    "e2e:seed": "nest build && ENSAIO_DATABASE_URL=\"${E2E_DATABASE_URL:-postgresql://alvesting:alvesting@localhost:25432/alvesting_e2e_test}\" node --enable-source-maps --env-file-if-exists=../../.env.example dist/ensaio-cli.js --logos-sinteticos",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@alvesting/contracts": "workspace:*",
    "@azure/communication-email": "1.1.0",
    "@azure/identity": "4.14.1",
    "@azure/monitor-opentelemetry": "1.20.1",
    "@azure/service-bus": "7.10.0",
    "@azure/storage-blob": "12.34.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-undici": "0.31.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.15",
    "csv-parse": "7.0.3",
    "fast-xml-parser": "5.11.2",
    "helmet": "8.3.0",
    "long": "5.3.2",
    "nestjs-pino": "5.3.1",
    "openai": "7.47.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ulid": "3.0.2",
    "undici": "8.12.3",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@alvesting/config": "workspace:*",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/instrumentation-pg": "0.73.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/yauzl": "3.4.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.14.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
