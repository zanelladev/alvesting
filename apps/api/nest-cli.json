{
  "$schema": "https://json.schemastore.org/nest-cli",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": true,
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      { "include": "**/*.json", "outDir": "dist" },
      { "include": "**/legal/*.md", "outDir": "dist" }
    ]
  }
}
