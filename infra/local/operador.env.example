# O arquivo de ambiente do operador local e do arena:retroativo (ADR 0038; docs/RUNBOOK.md, "Operador local"). É um MODELO: copie para FORA
# do repositório (por exemplo ~/segredos/alvesting-operador.env, com chmod 600), preencha os segredos lá e aponte o plist do launchd para ele
# (__ENV_FILE__). Nenhum segredo entra no git.

# O banco da temporada (o temporada:preparar o cria) e o de dev, que o parseEnv exige e o temporada:preparar só lê
TEMPORADA_DATABASE_URL=postgresql://alvesting:alvesting@localhost:25432/alvesting_temporada
DATABASE_URL=postgresql://alvesting:alvesting@localhost:25432/alvesting_dev
# o login da api (o db:roles do temporada:preparar): a MESMA senha de dev de todo banco deste servidor, a do .env.example
API_DATABASE_URL=postgresql://alvesting_api:alvesting_api@localhost:25432/alvesting_temporada

# O Azurite do docker compose (os arquivos da temporada ficam nos containers temporada-briefings e temporada-llm-io)
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true;DevelopmentStorageProxyUri=http://127.0.0.1:25100

# Os segredos: o token da brapi, a chave do OpenRouter e o prompt (o caminho de um arquivo fora do git, com a linha de canário)
BRAPI_TOKEN=
OPENROUTER_API_KEY=
PROMPT_ARENA_FILE=

# O teto de custo das LLMs no mês do pregão, em dólares (o sched-cycle de produção usa o mesmo; sem ele o ciclo pago é pulado)
ARENA_MONTHLY_COST_CAP_USD=40
